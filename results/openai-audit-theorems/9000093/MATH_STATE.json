      },
      "natural_statement": "The same comparison holds for every smooth strictly positive p,q with q log-concave and finite H(p|q) and I(p|q), without any moment assumption on p.",
      "formal_statement": "",
      "external_assumptions": [],
      "retired_assumptions": [],
