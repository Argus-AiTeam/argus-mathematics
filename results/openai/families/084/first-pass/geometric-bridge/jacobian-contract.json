{
  "server": {"name": "jacobian", "version": "0.14.0"},
  "protocol_version": "2025-11-25",
  "operation_id": "integer.counting.floor_sum.compute",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "a": {"maximum": 1000000, "minimum": 0, "type": "integer"},
      "b": {"maximum": 1000000, "minimum": 0, "type": "integer"},
      "m": {"maximum": 1000000, "minimum": 1, "type": "integer"},
      "n": {"maximum": 1000000000000000, "minimum": 0, "type": "integer"}
    },
    "required": ["n", "m", "a", "b"],
    "type": "object"
  },
  "output_schema": {
    "additionalProperties": false,
    "properties": {"value": {"pattern": "^(?:0|-?[1-9][0-9]*)$", "type": "string"}},
    "required": ["value"],
    "type": "object"
  },
  "application": "One exact local-boundary-count diagnostic, not a proof of the parameter-uniform theorem: q=2/3, x=1/7, n=6, finest block grid N_8=512. If A=512*(x+q^6), B=512*(x+2*q^6), the payload computes floor(B)+floor(384-A). The inclusive boundary count is the result minus 383."
}
