structure OAI.Problem355.ZeroDeterminantCount.RowData : Type
number of parameters: 0
fields:
  OAI.Problem355.ZeroDeterminantCount.RowData.B : ℕ
  OAI.Problem355.ZeroDeterminantCount.RowData.b : ℕ
  OAI.Problem355.ZeroDeterminantCount.RowData.e : ℕ
  OAI.Problem355.ZeroDeterminantCount.RowData.k : ℕ
  OAI.Problem355.ZeroDeterminantCount.RowData.prime : Nat.Prime self.B
  OAI.Problem355.ZeroDeterminantCount.RowData.e_le_k : self.e ≤ self.k
  OAI.Problem355.ZeroDeterminantCount.RowData.L : Submodule ℤ OAI.Problem355.ZeroDeterminantCount.IntVector
  OAI.Problem355.ZeroDeterminantCount.RowData.C : OAI.Problem355.ZeroDeterminantCount.IntMatrix
  OAI.Problem355.ZeroDeterminantCount.RowData.P : (Matrix (Fin 3) (Fin 3) (ZMod (self.B ^ self.k)))ˣ
  OAI.Problem355.ZeroDeterminantCount.RowData.Q : (Matrix (Fin 3) (Fin 3) (ZMod (self.B ^ self.k)))ˣ
  OAI.Problem355.ZeroDeterminantCount.RowData.diagonal : Matrix.map self.C ⇑(Int.castRingHom (ZMod (self.B ^ self.k))) =
      ↑self.P * Matrix.diagonal ![1, ↑self.B ^ self.b, ↑self.B ^ self.e] * ↑self.Q
