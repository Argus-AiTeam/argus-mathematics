OAI.Problem355.ZeroGlobalCount.weighted_count_le_log : ∀ (D : OAI.Problem355.ZeroDeterminantCount.RowData) (q N : ℕ)
  [inst : Fact (Nat.Prime q)],
  1 ≤ N →
    IsUnit ↑D.E →
      D.h ^ 26 ≤ ↑q →
        ∀ (S : Finset (Matrix (Fin 3) (Fin 3) ℤ)) (W : Matrix (Fin 3) (Fin 3) ℤ → ℝ) (Ca Cg Cd : ℝ),
          0 ≤ Ca →
            0 ≤ Cg →
              0 ≤ Cd →
                (∀ A ∈ S, 0 ≤ W A) →
                  (∀ A ∈ S, A.det = 0) →
                    (∀ A ∈ S, ∀ (i : Fin 3), A i ∈ D.L) →
                      (∀ A ∈ S, ∀ (i : Fin 3), A 2 i ≠ 0) →
                        (∀ A ∈ S,
                            ∀ (i j : Fin 3),
                              i ≠ j →
                                (↑(A 0 i) / ↑(A 2 i), ↑(A 1 i) / ↑(A 2 i)) ≠
                                  (↑(A 0 j) / ↑(A 2 j), ↑(A 1 j) / ↑(A 2 j))) →
                          (∀ A ∈ S, ∀ (i j : Fin 3), |A i j| ≤ ↑(2 * N)) →
                            (∀ A ∈ S,
                                0 < W A →
                                  ∃ T,
                                    OAI.Problem355.AuxiliaryCap.IsCap T ∧
                                      ∀ (i : Fin 3), (A.map ⇑(Int.castRingHom (ZMod q))).col i ∈ T) →
                              (∀ A ∈ S, AffineIndependent (ZMod q) (A.map ⇑(Int.castRingHom (ZMod q))).col → W A ≤ Ca) →
                                (∀ A ∈ S, W A ≤ Cg * ↑q ^ 2 * D.h ^ 24) →
                                  (∀ A ∈ S,
                                      (∃ i j,
                                          (A.map ⇑(Int.castRingHom (ZMod q))).col i ≠
                                            (A.map ⇑(Int.castRingHom (ZMod q))).col j) →
                                        W A ≤ Cd * ↑q * D.h ^ 12) →
                                    (∀ A ∈ S,
                                        ∀ (x : Fin 3 → ℤ),
                                          OAI.Problem355.PrimitiveNormal.IsPrimitive x →
                                            A.mulVec x = 0 →
                                              AffineIndependent (ZMod q) (A.map ⇑(Int.castRingHom (ZMod q))).col →
                                                0 < W A → D.h ^ 2 < ‖OAI.Problem355.PrimitiveNormal.toEuclidean x‖) →
                                      ∑ A ∈ S, W A ≤
                                        OAI.Problem355.ZeroGlobalCount.countConstant Ca Cg Cd * ↑N ^ 6 / ↑D.I ^ 2 *
                                          (Real.log (4 * ↑N) / Real.log 2)
@OAI.Problem355.AuxiliaryThreeCase.three_case_cover : ∀ {F : Type u_1} [inst : Field F] (x : Fin 3 → F),
  x ≠ 0 →
    ∀ (v : Fin 3 → Fin 3 → F),
      (AffineIndependent F v ∨ ∃ p, OAI.Problem355.WeightedZeroPartition.EqualPair v p) →
        AffineIndependent F v ∨
          (∃ p,
              OAI.Problem355.WeightedZeroPartition.EqualPair v p ∧
                ¬OAI.Problem355.AuxiliaryThreeCase.ExceptionalVector x p) ∨
            ∃ p,
              OAI.Problem355.WeightedZeroPartition.EqualPair v p ∧
                OAI.Problem355.AuxiliaryThreeCase.ExceptionalVector x p ∧ ∃ i j, v i ≠ v j
@OAI.Problem355.AuxiliaryThreeCase.special_weight_le_four : ∀ {F : Type u_1} [inst : Field F] [inst_1 : Fintype F]
  [inst_2 : Fintype ((Fin 3 → F) ≃ᵃ[F] Fin 3 → F)] (S : Finset (Fin 3 → F)),
  S.Nonempty →
    ∀ (T : Finset ((Fin 3 → F) ≃ᵃ[F] Fin 3 → F)),
      T.Nonempty →
        Fintype.card ((Fin 3 → F) ≃ᵃ[F] Fin 3 → F) ≤ 2 * T.card →
          ∀ (v : Fin 3 → Fin 3 → F),
            (∃ i j, v i ≠ v j) →
              OAI.Problem355.AuxiliaryWeights.affineInclusionWeight S T v ≤ 4 * (↑(Fintype.card F) ^ 3 / ↑S.card)
'OAI.Problem355.ZeroGlobalCount.weighted_count_le_log' depends on axioms: [propext, Classical.choice, Quot.sound]
