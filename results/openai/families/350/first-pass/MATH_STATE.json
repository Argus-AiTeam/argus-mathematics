    {
      "claim_id": "C_SEED",
      "version": 1,
      "context": {
        "kind": "context",
        "subject_id": "CTX_CORRUGATION",
        "content_hash": "819873de68a9539e5792f403e5ae4ebca0fa113b184fe8b32c0390e1f69a5c3a"
      },
      "natural_statement": "Lemma lem:seed: a smooth h0=-a*t on t<=1/2 has a uniform positive admissible J test on t>=1/4 and a positive-definite Hessian nonzero-gradient region U0, uniformly for smooth G in a sufficiently small C1 neighborhood of round S4.",
      "formal_statement": "",
      "external_assumptions": [],
