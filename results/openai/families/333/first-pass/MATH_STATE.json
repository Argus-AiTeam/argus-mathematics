    {
      "claim_id": "C_POLY_CORRECTION",
      "version": 1,
      "context": {
        "kind": "context",
        "subject_id": "CTX_EXACT",
        "content_hash": "281016d4d6d101bb393b65ead4abf96cbfc64e6a1510c943505075bd8e8435c5"
      },
      "natural_statement": "For every D>=4 and a,b,d>=0,L>0, finite jets through order 442, uniformly elliptic varying targets, defect O(z^N), and transverse second form >=c z^d suffice for smooth exact correction with C^2 displacement <=z^L, for a constant-independent finite N (research/exact_correction_audit/theorem.md).",
      "formal_statement": "",
      "external_assumptions": [],
      "retired_assumptions": [],
