    {
      "claim_id": "C_FINITE_WAIT_CORE",
      "version": 1,
      "context": {
        "kind": "context",
        "subject_id": "CTX_EXACT",
        "content_hash": "281016d4d6d101bb393b65ead4abf96cbfc64e6a1510c943505075bd8e8435c5"
      },
      "natural_statement": "The scalar all-order recurrence has arbitrarily late finite hitting times below B for every finite initial value; the metric-transfer identity and increment exponent margin hold universally.",
      "formal_statement": "import Mathlib\n\nnamespace ExactCorrectionAudit\n\ntheorem metric_transfer_identity\n    (g₁ g₂ s₁ s₂ u₁ u₂ h hs ht d e : ℝ) :\n    h - (g₁ + u₁) * (g₂ + u₂) - e ^ 2 * h =\n      ((h - g₁ * g₂) - d ^ 2 * hs) -\n        ((s₁ + u₁) * (s₂ + u₂) - s₁ * s₂ -\n          d ^ 2 * hs + e ^ 2 * ht) -\n        ((g₁ - s₁) * u₂ + (g₂ - s₂) * u₁) +\n        e ^ 2 * (ht - h) := by\n  ring\n\ntheorem summable_increment_margin (k m : ℝ)\n    (hk : 10 ≤ k) (hm : 2 * m ≤ k) :\n    1 < k + (6 / 5 : ℝ) * (1 - m) := by\n  linarith\n\ntheorem step_to_affine_bound (B x c y : ℝ)\n    (hB : 1 ≤ B) (hx : 0 ≤ x) (hc : c ≤ 1 / 4)\n    (hy : y ≤ B / 4 + c * (1 + x)) :\n    y ≤ B / 2 + x / 4 := by\n  have hcx : c * (1 + x) ≤ (1 / 4 : ℝ) * (1 + x) :=\n    mul_le_mul_of_nonneg_right hc (by linarith)\n  linarith\n\ntheorem block_bound (B : ℝ) (x : ℕ → ℝ)\n    (hB : 0 ≤ B)\n    (hstep : ∀ n, x (n + 1) ≤ B / 2 + x n / 4) :\n    ∀ n, x n ≤ (2 / 3 : ℝ) * B + (1 / 4 : ℝ) ^ n * x 0 := by\n  intro n\n  induction n with\n  | zero =>\n      simp only [pow_zero, one_mul]\n      linarith\n  | succ n ih =>\n      have hs := hstep n\n      rw [pow_succ]\n      nlinarith\n\ntheorem finite_waiting (B : ℝ) (x c : ℕ → ℝ)\n    (hB : 1 ≤ B) (hx : ∀ n, 0 ≤ x n)\n    (hc : ∀ n, c n ≤ 1 / 4)\n    (hstep : ∀ n, x (n + 1) ≤ B / 4 + c n * (1 + x n)) :\n    ∃ n, x n < B := by\n  have hden : 0 < 3 * (x 0 + 1) := by\n    have := hx 0\n    linarith\n  have hpositive : 0 < B / (3 * (x 0 + 1)) :=\n    div_pos (by linarith) hden\n  obtain ⟨n, hn⟩ :=\n    exists_pow_lt_of_lt_one hpositive (show (1 / 4 : ℝ) < 1 by norm_num)\n  have hn' : (1 / 4 : ℝ) ^ n * (3 * (x 0 + 1)) < B :=\n    (lt_div_iff₀ hden).mp hn\n  have hb := block_bound B x (by linarith)\n    (fun n => step_to_affine_bound B (x n) (c n) (x (n + 1))\n      hB (hx n) (hc n) (hstep n)) n\n  have hp : 0 ≤ (1 / 4 : ℝ) ^ n := pow_nonneg (by norm_num) n\n  exact ⟨n, by nlinarith⟩\n\ntheorem retained_bound_persists (B x c y : ℝ)\n    (hB : 1 ≤ B) (hx : 0 ≤ x) (hxB : x ≤ B)\n    (hc : c ≤ 1 / 4)\n    (hy : y ≤ B / 4 + c * (1 + x)) :\n    y < B := by\n  have := step_to_affine_bound B x c y hB hx hc hy\n  linarith\n\ntheorem finite_waiting_after (B : ℝ) (x c : ℕ → ℝ)\n    (hB : 1 ≤ B) (hx : ∀ n, 0 ≤ x n)\n    (hc : ∃ n₀, ∀ n, n₀ ≤ n → c n ≤ 1 / 4)\n    (hstep : ∀ n, x (n + 1) ≤ B / 4 + c n * (1 + x n)) :\n    ∀ start, ∃ n, start ≤ n ∧ x n < B := by\n  intro start\n  obtain ⟨n₀, hn₀⟩ := hc\n  let base := max n₀ start\n  have hshift : ∀ n, x (base + (n + 1)) ≤\n      B / 4 + c (base + n) * (1 + x (base + n)) := by\n    intro n\n    simpa only [Nat.add_assoc] using hstep (base + n)\n  obtain ⟨n, hn⟩ := finite_waiting B (fun n => x (base + n))\n    (fun n => c (base + n)) hB (fun n => hx (base + n))\n    (fun n => hn₀ (base + n) (by dsimp [base]; omega)) hshift\n  exact ⟨base + n, by dsimp [base]; omega, hn⟩\n\nend ExactCorrectionAudit\n",
      "external_assumptions": [],
      "retired_assumptions": [],
      "content_hash": "c5202a3377be5317c5342031c0fc789be961139ce9dfafa1a2d5bad069c10482"
    },
    {
      "claim_id": "C_POLY_CORRECTION",
      "version": 2,
      "context": {
        "kind": "context",
        "subject_id": "CTX_EXACT",
        "content_hash": "281016d4d6d101bb393b65ead4abf96cbfc64e6a1510c943505075bd8e8435c5"
      },
      "natural_statement": "Fix a closed smooth surface with background norms, D>=4, a,b,d>=0 and L>0. With R=440 there exists an integer N, independent of all implicit family constants, such that any smooth spatial immersions f_z:M->R^D and smooth uniformly elliptic metrics h_z satisfying ||f_z||C^{j+2}<=C_j z^(-a-b*j) for 0<=j<=R, ||gamma(f_z)-h_z||CR<=C z^N, and inf_p max_{|Y|bg=1}|B_fz(Y,Y)|>=c z^d admit, for sufficiently small z, smooth immersions fhat_z with gamma(fhat_z)=h_z and ||fhat_z-f_z||C2<=z^L. No parameter regularity or higher true-input bound is required; those higher derivatives may affect only finite waiting times. The small-z threshold may depend on the displayed constants.",
      "formal_statement": "",
      "external_assumptions": [],
      "retired_assumptions": [],
      "content_hash": "eefdd7883f3f7a40cf1bb3c7a656f95ed32df906fb11b7bd49dd3f8ca0ab387a"
    },
