        "content_hash": "6330d253f436eab282329cd1e5a04eb70f3677e154905fe056d2eada0c91342b"
      },
      "natural_statement": "Exactly one z in the specified closed square matches its origin shot to the constructed tail with source norm at most 0.3R; the matching map has maximum-norm Lipschitz constant below 0.37. The resulting profile satisfies C_PROFILE. Uniqueness is restricted to this square and this small-tail class.",
      "formal_statement": "",
      "external_assumptions": [],
      "retired_assumptions": [],
      "content_hash": "1bb2a648a2e994ec4268a050aa2a251733b79404007f4287eae01632d142ce1b"
