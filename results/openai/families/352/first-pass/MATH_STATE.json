        "kind": "context",
        "subject_id": "CTX_PROFILE",
        "content_hash": "6330d253f436eab282329cd1e5a04eb70f3677e154905fe056d2eada0c91342b"
      },
      "natural_statement": "There exist c>0 and a smooth positive global G with G(0)=1 and Gprime(0)<0, analytic at zero, bounded above and away from zero, satisfying Q(y d/dy)(G-1)=y^2(1/G-1/c)/2 and differentiated inverse-even-power asymptotics at all orders; its self-similar h gives the stated flat solution.",
      "formal_statement": "",
      "external_assumptions": [],
      "retired_assumptions": [],
      "content_hash": "49863b9ee41f1aee1cedc3c4d725d75c3e5a9d5bc12697fed06d318b7c0a10ac"
    },
