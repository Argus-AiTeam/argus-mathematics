  "theorem": "HypergraphInfluence.uniform_influence",
  "lean_version": "4.31.0",
  "statement": {
    "quantifiers": "forall r>=3, exists C_r>0, forall n>=r, forall 0<p<1, forall vertex-invariant Boolean f",
    "domain": "simple r-uniform hypergraphs on all r-element subsets of Fin n",
    "variance": "actual Bernoulli(p) product expectation of the squared centered 0/1 encoding",
    "influence": "sum of pivotal probabilities; no resampling or bias prefactor",
    "conclusion": "Var_p(f) <= C_r * I_p(f) / (log n)^(r/(r-1))",
    "monotonicity_required": false,
    "constant_independent_of": [
      "n",
      "p",
      "f"
    ]
  },
