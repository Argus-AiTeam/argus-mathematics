HypergraphInfluence.uniform_numerical_parameters (r : ℕ) (hr : 3 ≤ r) :
  ∃ C,
    0 < C ∧
      ∀ (n : ℕ),
        r ≤ n →
          1 / 4 ≤ C / Real.log ↑n ^ (↑r / (↑r - 1)) ∨
            ∃ m,
              r + 1 ≤ m ∧
                m ≤ n ∧
                  ∀ (σ : ℝ),
                    0 < σ →
                      σ ≤ 1 / 2 →
                        have k := σ * Real.log ↑m / 64;
                        have L := (k / ↑r) ^ (↑r / (↑r - 1));
                        0 < k ∧
                          0 < L ∧
                            ↑r * L * (↑m - 1) / (↑n - 1) ≤ 1 / 2 ∧
                              2 * ↑r * ↑m ^ (-1 / 4) + σ ^ 2 / L ≤ C / Real.log ↑n ^ (↑r / (↑r - 1))
'HypergraphInfluence.uniform_numerical_parameters' depends on axioms: [propext, Classical.choice, Quot.sound]
