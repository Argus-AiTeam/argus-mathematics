        "subject_id": "CTX_UB",
        "content_hash": "dd428c1f2bed1cab89574d6bc38a111ef63a44a2d2c1d0d6e0a33bb4eae64940"
      },
      "natural_statement": "Over F_2 the substitutions A=x^2,C=[x,y],B=y give an injective free-associative presentation whose ordinary Lie subalgebra contains every ordinary x,y Lie polynomial of weight greater than one.",
      "formal_statement": "",
      "external_assumptions": [],
      "retired_assumptions": [],
