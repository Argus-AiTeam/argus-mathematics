      },
      "natural_statement": "For every integer n>=0, dim_Q W_n <= dim_Q FreeLie_Q(e_3,e_5,e_7,...)_n, wt(e_j)=j, for the full staged rational equation space.",
      "formal_statement": "",
      "external_assumptions": [],
