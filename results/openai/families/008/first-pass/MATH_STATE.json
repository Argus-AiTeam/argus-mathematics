        "content_hash": "dd428c1f2bed1cab89574d6bc38a111ef63a44a2d2c1d0d6e0a33bb4eae64940"
      },
      "natural_statement": "For each leading B-count r of a reduced rational solution at weight n=2m+r>2, the staged leading pentagon holds modulo lower count in the target at symbolic length m+r, by count-monotone ordering with source independence only.",
      "formal_statement": "",
      "external_assumptions": [],
      "retired_assumptions": [],
