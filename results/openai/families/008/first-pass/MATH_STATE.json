      },
      "natural_statement": "For every n>2 and r>=0 the leading projection chi(A,C,B)->chi(0,C,B) is injective on gr_F^r of the saturated rational-solution reduction.",
      "formal_statement": "",
      "external_assumptions": [],
      "retired_assumptions": [],
