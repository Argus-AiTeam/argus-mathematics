RankSignatures.penalty_zero_iff.{u_1} {E : Type u_1} [Fintype E] [DecidableEq E] (f : Finset E → ℤ) (hf₀ : f ∅ = 0)
  (v : E → ℤ) : RankSignatures.penalty f v = 0 ↔ RankSignatures.InBase f v
RankSignatures.boxed_groupedWeight_limit.{u_1, u_3, u_4} {E : Type u_1} {I : Type u_3} [Fintype E] [DecidableEq E]
  [Fintype I] [DecidableEq I] {K : Type u_4} [Fintype K] [DecidableEq K] (f : K → Finset E → ℤ)
  (hf₀ : ∀ (k : K), f k ∅ = 0) (b : K → E → ℤ) (caps : I → ℤ) (a : I → K) (g : I → E) (orientation : K → Bool)
  (z : I → ℤ) :
  Filter.Tendsto
    (fun H => RankSignatures.boxedWeight (RankSignatures.groupedWeight f (fun x => H) b caps a g orientation) caps z)
    Filter.atTop
    (nhds
      (if
          RankSignatures.InBox caps z ∧
            ∀ (k : K), RankSignatures.InBase (f k) (RankSignatures.groupedVector b caps a g orientation z k) then
        1
      else 0))
RankSignatures.exists_monotone_modular_shift.{u_1} {E : Type u_1} [Fintype E] [DecidableEq E] (f : Finset E → ℤ)
  (b : E → ℤ) :
  ∃ c,
    (∀ (e : E), 0 ≤ b e + c e) ∧
      ∀ (A B : Finset E), A ⊆ B → RankSignatures.modularShift f c A ≤ RankSignatures.modularShift f c B
RankSignatures.modularShift_base.{u_1} {E : Type u_1} [Fintype E] [DecidableEq E] (f : Finset E → ℤ) (v c : E → ℤ) :
  RankSignatures.InBase (RankSignatures.modularShift f c) (v + c) ↔ RankSignatures.InBase f v
RankSignatures.penalty_modularShift.{u_1} {E : Type u_1} [Fintype E] [DecidableEq E] (f : Finset E → ℤ) (v c : E → ℤ) :
  RankSignatures.penalty (RankSignatures.modularShift f c) (v + c) = RankSignatures.penalty f v
