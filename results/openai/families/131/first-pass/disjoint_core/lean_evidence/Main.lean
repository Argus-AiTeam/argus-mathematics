variable {V : Type*} [Fintype V] [DecidableEq V]

 theorem raw_eq_equalityVector (q : ℕ) (i j : V) :
    raw q i j = SliceEuclideanGenerator.equalityVector q
      (SliceMoments.equalMean (Finset.univ : Finset V) q) i j := by
