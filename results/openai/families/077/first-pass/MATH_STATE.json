    },
    {
      "claim_id": "CP_NONLINEAR_CHAIN",
      "version": 2,
      "context": {
        "kind": "context",
        "subject_id": "CTX_CP",
        "content_hash": "54df73a64761179b5018c231b315d6c614282f026639493f0cc6d971c0cbc055"
      },
      "natural_statement": "Let delta=1/b for dyadic b>=16, J>=4, n=J-3, 0<a<s<=1, A,B>=1 and delta<=g<=1/4. Let nu on [-1,1]^2 be Frostman s with constant A at radii [delta,1]. Suppose original normalized target cells at levels j=3,...,J-1 have the same bounds outside masses beta_j, and distinct pairs have original reverse radial exponent a with constant B outside mass gamma. For Q_f(d)=(r_d-r_f)(t_d-t_f), every incidence E whose final delta^J output support has at most N bins per pin has product mass rho<=gamma+sum_j beta_j+A(2g)^s+sqrt(8K0) N^(1/(2n))(delta/g)^(a/2), where K0=65536 A(A+B)/(s-a).",
      "formal_statement": "",
      "external_assumptions": [],
      "retired_assumptions": [],
      "content_hash": "965489aed195e944d828c38d196a4d07bc9c370cba18a86f582818cc13acfa34"
    },
    {
