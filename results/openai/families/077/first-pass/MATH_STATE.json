        "subject_id": "CTX_CP",
        "content_hash": "54df73a64761179b5018c231b315d6c614282f026639493f0cc6d971c0cbc055"
      },
      "natural_statement": "For every realizing sequence of bounded planar laws with time Frostman exponent 0<s<=1, positive tilt exponent, and the stated affine hereditary simultaneous-refinement bounds, the dense-strip and power-light-strip conclusions of proj:product hold uniformly under arbitrary dense incidences. With the stated matched spatial support and weight realizations, the equal-slope rates satisfy g,H>=f_s(p). The nonlinear mechanism has the explicit finite bound recorded in CP_NONLINEAR_CHAIN.",
      "formal_statement": "",
      "external_assumptions": [
        {
          "assumption_id": "RW41",
          "statement": "Ren--Wang finite incident tube-pencil Theorem 4.1 supplies the exponent min{k,(k+sigma)/2,1}, with arbitrarily small output error after choosing its input losses; it is used both in the radial bootstrap and in the final weighted projection test.",
          "source": "Ren and Wang, Furstenberg sets estimate in the plane, arXiv version 2; exact primary statement and hypotheses retained in research/certificates/correlated-product/ren_wang_v2_excerpt.txt.",
