      "version": 3,
      "context": {
        "kind": "context",
        "subject_id": "CTX_CP",
        "content_hash": "54df73a64761179b5018c231b315d6c614282f026639493f0cc6d971c0cbc055"
      },
      "natural_statement": "For every 0<a<s<=1, a planar Frostman s law with arbitrarily small losses and uniformly power-small mass in strips of every fixed positive power width has power-small pair exceptions to the original centered radial a bounds on every fixed finite power grid. This follows from the finite Ren--Wang input via a finite dispersed/concentrated-tube bootstrap, not from a Hausdorff-dimension discretization.",
      "formal_statement": "",
      "external_assumptions": [
        {
          "assumption_id": "RW41",
