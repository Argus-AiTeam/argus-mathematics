{
  "schema_version": 1,
  "protocol_version": "2025-11-25",
  "server": {"name": "jacobian", "version": "0.14.0"},
  "transport": "mcp-stdio",
  "operation_id": "combinatorics.generating_function.coefficients.compute",
  "description": "Expand one exact rational function N(x)/D(x) at zero through a bounded finite truncation and expose the residual congruence.",
  "input_schema": {
    "$defs": {
      "CanonicalRational": {
        "additionalProperties": false,
        "description": "A reduced rational whose denominator is positive and whose zero is 0/1.",
        "examples": [{"den": "2", "num": "1"}],
        "properties": {
          "den": {"description": "Positive canonical decimal denominator; together with num it must be reduced, and integers use den='1'.", "examples": ["2"], "pattern": "^(?:0|-?[1-9][0-9]*)$", "title": "Den", "type": "string"},
          "num": {"description": "Canonical decimal numerator of the reduced rational.", "examples": ["1"], "pattern": "^(?:0|-?[1-9][0-9]*)$", "title": "Num", "type": "string"}
        },
        "required": ["num", "den"],
        "title": "CanonicalRational",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Expand N(x)/D(x) at zero through one explicit finite order.",
    "properties": {
      "coefficient_convention": {"const": "ASCENDING_POWERS_OF_X", "title": "Coefficient Convention", "type": "string"},
      "denominator": {"items": {"$ref": "#/$defs/CanonicalRational"}, "maxItems": 33, "minItems": 1, "title": "Denominator", "type": "array"},
      "expansion_point": {"const": "0", "title": "Expansion Point", "type": "string"},
      "numerator": {"items": {"$ref": "#/$defs/CanonicalRational"}, "maxItems": 33, "minItems": 1, "title": "Numerator", "type": "array"},
      "truncation_order": {"maximum": 512, "minimum": 1, "title": "Truncation Order", "type": "integer"}
    },
    "required": ["numerator", "denominator", "coefficient_convention", "expansion_point", "truncation_order"],
    "title": "RationalGeneratingFunctionCoefficientsRequest",
    "type": "object"
  },
  "output_schema": {
    "$defs": {
      "CanonicalRational": {
        "additionalProperties": false,
        "description": "A reduced rational whose denominator is positive and whose zero is 0/1.",
        "examples": [{"den": "2", "num": "1"}],
        "properties": {
          "den": {"description": "Positive canonical decimal denominator; together with num it must be reduced, and integers use den='1'.", "examples": ["2"], "pattern": "^(?:0|-?[1-9][0-9]*)$", "title": "Den", "type": "string"},
          "num": {"description": "Canonical decimal numerator of the reduced rational.", "examples": ["1"], "pattern": "^(?:0|-?[1-9][0-9]*)$", "title": "Num", "type": "string"}
        },
        "required": ["num", "den"],
        "title": "CanonicalRational",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "coefficient_convention": {"const": "ASCENDING_POWERS_OF_X", "title": "Coefficient Convention", "type": "string"},
      "coefficients": {"items": {"$ref": "#/$defs/CanonicalRational"}, "maxItems": 512, "minItems": 1, "title": "Coefficients", "type": "array"},
      "determinism": {"const": "DETERMINISTIC", "default": "DETERMINISTIC", "title": "Determinism", "type": "string"},
      "exactness": {"const": "EXACT_RATIONAL", "default": "EXACT_RATIONAL", "title": "Exactness", "type": "string"},
      "expansion_point": {"const": "0", "title": "Expansion Point", "type": "string"},
      "residual_coefficients": {"items": {"$ref": "#/$defs/CanonicalRational"}, "maxItems": 512, "minItems": 1, "title": "Residual Coefficients", "type": "array"},
      "residual_congruence": {"const": "DENOMINATOR_TIMES_SERIES_MINUS_NUMERATOR_IS_ZERO_MOD_X_TO_ORDER", "title": "Residual Congruence", "type": "string"},
      "truncation_order": {"maximum": 512, "minimum": 1, "title": "Truncation Order", "type": "integer"}
    },
    "required": ["coefficient_convention", "expansion_point", "truncation_order", "coefficients", "residual_congruence", "residual_coefficients"],
    "title": "RationalGeneratingFunctionCoefficientsResult",
    "type": "object"
  },
  "adapter_exit_code": 0,
  "error": null,
  "timeout": false
}
