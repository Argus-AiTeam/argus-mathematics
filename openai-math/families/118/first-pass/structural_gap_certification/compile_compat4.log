OAI.BinPackingGap.structural_additive_gap (c : ℕ) :
  ∃ I B,
    I.n = 5 * B ∧
      (∀ (i : Fin I.n), 1 / 6 < I.size i ∧ I.size i < 1) ∧
        B + c < OAI.BinPackingGap.opt I ∧ OAI.BinPackingGap.individualLP I = ↑B ∧ OAI.BinPackingGap.typeLP I = ↑B
