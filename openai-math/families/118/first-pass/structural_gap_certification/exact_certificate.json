  "formal_signature": "theorem structural_additive_gap (c : ℕ) :\n    ∃ I : Instance, ∃ B : ℕ,\n      I.n = 5 * B ∧\n      (∀ i, (1 / 6 : ℚ) < I.size i ∧ I.size i < 1) ∧\n      B + c < opt I ∧ individualLP I = (B : ℝ) ∧ typeLP I = (B : ℝ)",
