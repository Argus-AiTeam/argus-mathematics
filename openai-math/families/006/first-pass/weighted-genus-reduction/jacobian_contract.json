        "type": "integer"
      },
      "prime": {
        "minimum": 3,
        "maximum": 10000000,
        "type": "integer"
      }
    },
    "required": ["a", "prime"],
    "type": "object"
  },
  "output_schema": {
    "additionalProperties": false,
    "properties": {
      "a": {"type": "integer"},
      "prime": {
        "minimum": 3,
        "maximum": 10000000,
        "type": "integer"
      },
      "symbol": {"enum": [-1, 0, 1], "type": "integer"}
    },
    "required": ["a", "prime", "symbol"],
    "type": "object"
  },
  "adapter_exit_code": 0,
  "adapter_error": null,
  "adapter_timeout": false
}
