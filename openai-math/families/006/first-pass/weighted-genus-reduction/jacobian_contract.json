{
  "server": {
    "name": "jacobian",
    "version": "0.14.0"
  },
  "protocol_version": "2025-11-25",
  "operation_id": "number_theory.compute.legendre_symbol",
  "discovery_queries": [
    "optimal embeddings imaginary quadratic order quaternion Eichler genus character weighted trace",
    "Kronecker symbol binary quadratic form imaginary class group",
