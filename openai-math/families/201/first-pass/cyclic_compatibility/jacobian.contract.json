{
  "schema_version": 1,
  "protocol_version": "2025-11-25",
  "server": {"name": "jacobian", "version": "0.14.0"},
  "operation_id": "matrix.nullspace.compute",
  "input_schema": {
    "$defs": {
      "CanonicalRational": {
        "additionalProperties": false,
        "description": "A reduced rational whose denominator is positive and whose zero is 0/1.",
        "examples": [{"den": "2", "num": "1"}],
        "properties": {
          "den": {"description": "Positive canonical decimal denominator; together with num it must be reduced, and integers use den='1'.", "examples": ["2"], "pattern": "^(?:0|-?[1-9][0-9]*)$", "title": "Den", "type": "string"},
          "num": {"description": "Canonical decimal numerator of the reduced rational.", "examples": ["1"], "pattern": "^(?:0|-?[1-9][0-9]*)$", "title": "Num", "type": "string"}
        },
        "required": ["num", "den"],
        "title": "CanonicalRational",
        "type": "object"
      },
      "RationalMatrix": {
        "additionalProperties": false,
        "description": "One nonempty rectangular matrix over canonical rationals.",
        "properties": {
          "domain": {"const": "QQ", "default": "QQ", "title": "Domain", "type": "string"},
          "entries": {"items": {"items": {"$ref": "#/$defs/CanonicalRational"}, "type": "array"}, "maxItems": 64, "minItems": 1, "title": "Entries", "type": "array"}
        },
        "required": ["entries"],
        "title": "RationalMatrix",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {"matrix": {"$ref": "#/$defs/RationalMatrix"}},
    "required": ["matrix"],
    "title": "RationalMatrixRequest",
    "type": "object"
  },
  "output_schema": {
    "$defs": {
      "CanonicalRational": {
        "additionalProperties": false,
        "description": "A reduced rational whose denominator is positive and whose zero is 0/1.",
        "examples": [{"den": "2", "num": "1"}],
        "properties": {
          "den": {"description": "Positive canonical decimal denominator; together with num it must be reduced, and integers use den='1'.", "examples": ["2"], "pattern": "^(?:0|-?[1-9][0-9]*)$", "title": "Den", "type": "string"},
          "num": {"description": "Canonical decimal numerator of the reduced rational.", "examples": ["1"], "pattern": "^(?:0|-?[1-9][0-9]*)$", "title": "Num", "type": "string"}
        },
        "required": ["num", "den"],
        "title": "CanonicalRational",
        "type": "object"
      },
      "RationalMatrix": {
        "additionalProperties": false,
        "description": "One nonempty rectangular matrix over canonical rationals.",
        "properties": {
          "domain": {"const": "QQ", "default": "QQ", "title": "Domain", "type": "string"},
          "entries": {"items": {"items": {"$ref": "#/$defs/CanonicalRational"}, "type": "array"}, "maxItems": 64, "minItems": 1, "title": "Entries", "type": "array"}
        },
        "required": ["entries"],
        "title": "RationalMatrix",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "A structurally bounded fundamental-nullspace outcome.\n\nExact kernel output uses :meth:`_from_kernel`; independently supplied\nclaims are checked by ``verify_nullspace_result`` in the operation owner.",
    "properties": {
      "ambient_dimension": {"maximum": 32, "minimum": 1, "title": "Ambient Dimension", "type": "integer"},
      "basis_vectors": {"items": {"items": {"$ref": "#/$defs/CanonicalRational"}, "type": "array"}, "maxItems": 32, "title": "Basis Vectors", "type": "array"},
      "convention": {"const": "RREF_FUNDAMENTAL_BASIS", "default": "RREF_FUNDAMENTAL_BASIS", "title": "Convention", "type": "string"},
      "free_columns": {"items": {"type": "integer"}, "maxItems": 32, "title": "Free Columns", "type": "array"},
      "matrix": {"$ref": "#/$defs/RationalMatrix"},
      "nullity": {"maximum": 32, "minimum": 0, "title": "Nullity", "type": "integer"},
      "rank": {"maximum": 32, "minimum": 0, "title": "Rank", "type": "integer"}
    },
    "required": ["matrix", "ambient_dimension", "rank", "nullity", "basis_vectors", "free_columns"],
    "title": "NullspaceResult",
    "type": "object"
  }
}
