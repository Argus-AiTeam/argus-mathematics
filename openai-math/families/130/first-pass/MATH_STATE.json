      "version": 2,
      "context": {
        "kind": "context",
        "subject_id": "NET9000130",
        "content_hash": "f862606ca84af2bf29414b9d3628df4b57064189d917a2536e79fd0bdf07f454"
      },
      "natural_statement": "net:tensor-bound: W_star=2^71, S=(2^71)*1000000-6871402692000000 and lambda=S/W_star give t(k)<=A+lambda*t(floor(k/1000000)); exact batches imply C^{tensor k} costs O(2^k(k+1)^theta), theta=log_1000000(lambda)<1, for all k>=0.",
      "formal_statement": "",
      "external_assumptions": [],
      "retired_assumptions": [],
