      "context_id": "CTX371_BRIDGE",
      "version": 1,
      "statement": "Audit the outgoing-to-fixed-shell bridge for the twelve-dimensional circular spectral system, conditional on the explicitly stated exterior profile estimates; both escaping parameter regimes are included.",
      "definitions": {
        "lambda": "sigma+i*omega, -1/32<=sigma<=4, omega>=0",
        "regime_I": "ell/sqrt(1+omega) tends to infinity",
        "regime_II": "omega tends to infinity and ell/sqrt(omega) stays bounded",
        "outgoing": "for every fixed Euler derivative order j, D^j v_h=O(r^(-2(a+sigma)))",
        "shell": "R in [B0,B0+1], B0 fixed above r_b and sufficiently large for the regime-II angular-ratio bound"
      },
