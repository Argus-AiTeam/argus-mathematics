        "subject_id": "CTX371_BRIDGE",
        "content_hash": "9ac30de5c4dbe55e664b5ec968cc8ce408b8c454d98492fde79f886b8613bd42"
      },
      "natural_statement": "Conditional on the exterior profile symbol estimates, every outgoing solution in either escaping regime satisfies q'_h(R)=B_h(R)q_h(R)+o(n_*)|q(R)| uniformly on the fixed shell, as an operator estimate on the entire outgoing space.",
      "formal_statement": "",
      "external_assumptions": [],
      "retired_assumptions": [],
      "content_hash": "1fdee31293d77d49cdc877e12d6d425baafb61f20e33e1e21c9852713d3b2b7e"
    },
    {
      "claim_id": "C371_BRIDGE",
