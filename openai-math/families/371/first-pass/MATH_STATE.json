        "content_hash": "68d5ecc6021fd20a7e78de3d5b68076b4d6bc8fae4d38d879981766e5d22052f"
      },
      "natural_statement": "Adversarially audit, verify, or refute OpenAI Manuscript Family 371 (Stable blowup for the defocusing Schrödinger equation.; papers: Stable self-similar blowup for a supercritical defocusing Schrödinger equation on the torus; Lean status: Partially/Comparator formalized (lean/docs/371.md)): either (a) discover and certify an explicit mathematical flaw, sign/orientation error, counterexample to an intermediate lemma, or statement-fidelity/citation gap with a deterministic symbolic/computational certificate (`verify.py` + `exact_certificate.json`), or (b) independently verify, repair, or generalize the manuscript's core mathematical theorem with a standalone machine-checkable certificate certified by the independent Reviewer.",
      "formal_statement": "",
      "external_assumptions": [],
      "retired_assumptions": [],
      "content_hash": "8549af1d6ae9dc8dee6ded200b82485f666628d7227fbd8a0642a3a0d1a28e5e"
    },
    {
      "claim_id": "C371_MAIN",
      "version": 1,
      "context": {
        "kind": "context",
        "subject_id": "CTX371_BRIDGE",
        "content_hash": "9ac30de5c4dbe55e664b5ec968cc8ce408b8c454d98492fde79f886b8613bd42"
      },
      "natural_statement": "Manuscript thm:blowup asserts a nonempty H^k-open set of finite-time blowup data on the twelve-dimensional torus; this mission does not verify the full theorem.",
      "formal_statement": "",
      "external_assumptions": [],
      "retired_assumptions": [],
      "content_hash": "0252fa92e172106f892bd2c2b470235cd059d54b61e9c9c6d1dd574079523cbb"
    },
    {
      "claim_id": "C371_PROFILE",
      "version": 1,
      "context": {
        "kind": "context",
        "subject_id": "CTX371_BRIDGE",
        "content_hash": "9ac30de5c4dbe55e664b5ec968cc8ce408b8c454d98492fde79f886b8613bd42"
      },
      "natural_statement": "Manuscript profile:existence supplies smooth nonvanishing profiles, bounded b, exterior P/a Euler-symbol bounds, and bounded Euler derivatives of exp(2i phi); this mission takes these profile hypotheses conditionally.",
      "formal_statement": "",
      "external_assumptions": [],
      "retired_assumptions": [],
      "content_hash": "78c32547cac0fc2ea84eb2833aae12216e53617d2cd285bc250dfd154a81940b"
    },
    {
      "claim_id": "C371_SPECTRUM",
      "version": 1,
      "context": {
        "kind": "context",
        "subject_id": "CTX371_BRIDGE",
        "content_hash": "9ac30de5c4dbe55e664b5ec968cc8ce408b8c454d98492fde79f886b8613bd42"
      },
      "natural_statement": "Manuscript spectrum:classification asserts that the only regular outgoing modes with Re(lambda)>=-1/32 are phase, translation, and time symmetries; bounded and escaping parameters both require control.",
      "formal_statement": "",
      "external_assumptions": [],
      "retired_assumptions": [],
      "content_hash": "216fb5752db2b1bdec0d73566159df66efefbe91634e76b0bdc2315d7fcc6e99"
    },
    {
      "claim_id": "C371_BOUNDED",
      "version": 1,
      "context": {
        "kind": "context",
        "subject_id": "CTX371_BRIDGE",
        "content_hash": "9ac30de5c4dbe55e664b5ec968cc8ce408b8c454d98492fde79f886b8613bd42"
      },
      "natural_statement": "A count restricted to bounded angular and spectral parameters does not exclude an escaping sequence; the constrained compact limit is a separate manuscript argument.",
      "formal_statement": "",
      "external_assumptions": [],
      "retired_assumptions": [],
      "content_hash": "da3fbb6964a0cd3dd5e94cf386e880dd943f87c99b1ce8f5597a59da89e796a1"
    },
    {
      "claim_id": "C371_HIGH",
      "version": 1,
      "context": {
        "kind": "context",
        "subject_id": "CTX371_BRIDGE",
        "content_hash": "9ac30de5c4dbe55e664b5ec968cc8ce408b8c454d98492fde79f886b8613bd42"
      },
      "natural_statement": "Manuscript spec:high-exclusion excludes escaping regular outgoing modes using the uniform shell Robin estimate followed by interior energy and flux identities; the interior argument is outside this mission's verification boundary.",
      "formal_statement": "",
      "external_assumptions": [],
      "retired_assumptions": [],
      "content_hash": "4b123dec0e3ede6c9d4d53b9fd1e293a6889435370555e9f9af45353e30e9b10"
