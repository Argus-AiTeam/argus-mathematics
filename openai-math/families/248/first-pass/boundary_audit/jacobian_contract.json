{
  "protocol_version": "2025-11-25",
  "schema_version": 1,
  "server": {"name": "jacobian", "version": "0.14.0"},
  "transport": "mcp-stdio",
  "operation_id": "probability.finite_distribution.raw_moment.compute",
  "inspection": {
    "description": "Compute one bounded raw moment of a normalized finite exact rational distribution, preserving every atom contribution. Order one is the distribution's exact expectation or expected value.",
    "input_schema": {
      "$defs": {
        "CanonicalRational": {
          "additionalProperties": false,
          "description": "A reduced rational whose denominator is positive and whose zero is 0/1.",
          "examples": [{"den": "2", "num": "1"}],
          "properties": {
            "den": {
              "description": "Positive canonical decimal denominator; together with num it must be reduced, and integers use den='1'.",
              "examples": ["2"],
              "pattern": "^(?:0|-?[1-9][0-9]*)$",
              "title": "Den",
              "type": "string"
            },
            "num": {
              "description": "Canonical decimal numerator of the reduced rational.",
              "examples": ["1"],
              "pattern": "^(?:0|-?[1-9][0-9]*)$",
              "title": "Num",
              "type": "string"
            }
          },
          "required": ["num", "den"],
          "title": "CanonicalRational",
          "type": "object"
        },
        "FiniteDistributionAtom": {
          "additionalProperties": false,
          "properties": {
            "probability": {"$ref": "#/$defs/CanonicalRational"},
            "value": {"$ref": "#/$defs/CanonicalRational"}
          },
          "required": ["value", "probability"],
          "title": "FiniteDistributionAtom",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "atoms": {
          "items": {"$ref": "#/$defs/FiniteDistributionAtom"},
          "maxItems": 256,
          "minItems": 1,
          "title": "Atoms",
          "type": "array"
        },
        "order": {
          "maximum": 128,
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        }
      },
      "required": ["atoms", "order"],
      "title": "FiniteRawMomentRequest",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "CanonicalRational": {
          "additionalProperties": false,
          "description": "A reduced rational whose denominator is positive and whose zero is 0/1.",
          "examples": [{"den": "2", "num": "1"}],
          "properties": {
            "den": {
              "description": "Positive canonical decimal denominator; together with num it must be reduced, and integers use den='1'.",
              "examples": ["2"],
              "pattern": "^(?:0|-?[1-9][0-9]*)$",
              "title": "Den",
              "type": "string"
            },
            "num": {
              "description": "Canonical decimal numerator of the reduced rational.",
              "examples": ["1"],
              "pattern": "^(?:0|-?[1-9][0-9]*)$",
              "title": "Num",
              "type": "string"
            }
          },
          "required": ["num", "den"],
          "title": "CanonicalRational",
          "type": "object"
        },
        "FiniteRawMomentContribution": {
          "additionalProperties": false,
          "properties": {
            "contribution": {"$ref": "#/$defs/CanonicalRational"},
            "powered_value": {"$ref": "#/$defs/CanonicalRational"},
            "probability": {"$ref": "#/$defs/CanonicalRational"},
            "value": {"$ref": "#/$defs/CanonicalRational"}
          },
          "required": ["value", "probability", "powered_value", "contribution"],
          "title": "FiniteRawMomentContribution",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "contributions": {
          "items": {"$ref": "#/$defs/FiniteRawMomentContribution"},
          "maxItems": 256,
          "minItems": 1,
          "title": "Contributions",
          "type": "array"
        },
        "moment": {"$ref": "#/$defs/CanonicalRational"},
        "order": {
          "maximum": 128,
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        }
      },
      "required": ["order", "moment", "contributions"],
      "title": "FiniteRawMomentResult",
      "type": "object"
    },
    "read_only": true
  },
  "scope": "Exact second moment for a rational realized-color regression only.",
  "mismatch": "The inspected contract does not certify universally quantified dyadic transports, recursive coloring, or the boundary proposition. Those obligations are proved in Lean, not inferred from this finite calculation.",
  "regression": {
    "D": 2,
    "parent_intervals": [["1/8", "1/4"], ["3/8", "1/2"]],
    "map": "f(x)=(x+1)/2 on [-1,1]; no positive uniform displacement is asserted",
    "A": ["identity", "standard_x0"],
    "uniform_level": 8,
    "variable": "z_1-m",
    "expected_moment": "17/128"
  }
}
