#!/usr/bin/env python3
# Preserve a pinned GitHub Lean import closure with independently checked Git blob hashes.
"""Fetch source evidence, not compiled proof evidence.

Example:
  math-source-closure --repo openai/math --commit FULL_SHA --source-root lean \
    --entry OAI.Probability.Example.Main --index-dir OAI.Probability.Example \
    --output snapshot

Only modules with an entry point's top-level prefix are followed. Other imports
are recorded as external boundaries. --index-dir indexes a bounded subtree and
rejects truncated trees; unindexed local imports use the pinned contents API.
Existing sources are reused only when their Git blob hash matches upstream.
No Lean, Lake, build, or downloaded code is executed.
"""
import argparse
import concurrent.futures
import hashlib
import json
import re
import sys
import urllib.request
from pathlib import Path


def lean_code(text):
    """Blank comments and strings, preserving newlines and offsets."""
    out = list(text)
    i, depth = 0, 0
    string = False
    while i < len(text):
        pair = text[i:i + 2]
        if depth:
            if pair == "/-":
                depth += 1
            elif pair == "-/":
                depth -= 1
            else:
                out[i] = "\n" if text[i] == "\n" else " "
                i += 1
                continue
            out[i:i + 2] = "  "
            i += 2
        elif string:
            if text[i] == "\\":
                out[i:i + 2] = "  "
                i += 2
            else:
                string = text[i] != '"'
                out[i] = "\n" if text[i] == "\n" else " "
                i += 1
        elif pair == "/-":
            depth = 1
            out[i:i + 2] = "  "
            i += 2
        elif pair == "--":
            end = text.find("\n", i)
            end = len(text) if end < 0 else end
            out[i:end] = " " * (end - i)
            i = end
        elif text[i] == '"':
            string = True
            out[i] = " "
            i += 1
        else:
            i += 1
    if depth or string:
        raise ValueError("unclosed comment or string; import parsing is unsafe")
    return "".join(out)


def imports(text):
    code = lean_code(text)
    result = []
    for match in re.finditer(r"(?m)^\s*(?:(?:public|private)\s+)?import[ \t]+([^\n]+)", code):
        for module in match.group(1).split():
            if not re.fullmatch(r"[A-Za-z_][A-Za-z_0-9']*(?:\.[A-Za-z_][A-Za-z_0-9']*)*", module):
                raise ValueError(f"unsupported import syntax: {module!r}")
            result.append(module)
    return result


def blob_hash(data):
    return hashlib.sha1(f"blob {len(data)}\0".encode() + data).hexdigest()


def fetch(url):
    request = urllib.request.Request(url, headers={"User-Agent": "math-source-closure"})
    with urllib.request.urlopen(request, timeout=90) as response:
        data = response.read(32 * 1024 * 1024 + 1)
    if len(data) > 32 * 1024 * 1024:
        raise ValueError(f"response exceeds 32 MiB: {url}")
    return data


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--commit", required=True)
    parser.add_argument("--source-root", default="lean")
    parser.add_argument("--entry", action="append", required=True)
    parser.add_argument("--index-dir", action="append", default=[])
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--max-files", type=int, default=1000)
    args = parser.parse_args()
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", args.repo):
        parser.error("--repo must be owner/name")
    if not re.fullmatch(r"[0-9a-f]{40}", args.commit):
        parser.error("--commit must be a full lowercase Git SHA")
    if not re.fullmatch(r"[A-Za-z0-9_/-]+", args.source_root) or ".." in args.source_root:
        parser.error("invalid --source-root")
    for module in args.entry + args.index_dir:
        if not re.fullmatch(r"[A-Za-z_][A-Za-z_0-9']*(?:\.[A-Za-z_][A-Za-z_0-9']*)*", module):
            parser.error(f"unsupported module name: {module!r}")
    output = args.output.resolve()
    output.mkdir(parents=True, exist_ok=True)
    api = f"https://api.github.com/repos/{args.repo}"
    raw = f"https://raw.githubusercontent.com/{args.repo}/{args.commit}"
    known, metadata = {}, []

    def api_json(endpoint, filename):
        data = fetch(api + endpoint)
        path = output / "metadata" / filename
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(data)
        metadata.append({"path": str(path.relative_to(output)), "url": api + endpoint})
        return json.loads(data)

    for module in args.index_dir:
        directory = args.source_root + "/" + module.replace(".", "/")
        parent, name = directory.rsplit("/", 1)
        listing = api_json(f"/contents/{parent}?ref={args.commit}",
                           module + ".parent.json")
        tree_sha = next(item["sha"] for item in listing if item["name"] == name)
        tree = api_json(f"/git/trees/{tree_sha}?recursive=1", module + ".tree.json")
        if tree.get("truncated", True):
            raise ValueError(f"truncated subtree: {directory}; choose smaller --index-dir")
        for item in tree["tree"]:
            if item["type"] == "blob":
                known[directory + "/" + item["path"]] = item["sha"]

    prefixes = {module.split(".")[0] for module in args.entry}
    sources, external = {}, set()
    pending = set(args.entry)
    while pending:
        wave = sorted(pending - sources.keys())
        pending.clear()
        if len(sources) + len(wave) > args.max_files:
            raise ValueError(f"closure exceeds --max-files={args.max_files}")
        jobs = []
        for module in wave:
            path = args.source_root + "/" + module.replace(".", "/") + ".lean"
            if path not in known:
                item = api_json(f"/contents/{path}?ref={args.commit}", module + ".file.json")
                known[path] = item["sha"]
            jobs.append((module, path, known[path]))

        def save(job):
            module, path, expected = job
            destination = output / "upstream" / path
            data = destination.read_bytes() if destination.exists() else fetch(raw + "/" + path)
            actual = blob_hash(data)
            if actual != expected:
                raise ValueError(f"Git blob mismatch: {path}: {actual} != {expected}")
            dependencies = imports(data.decode())
            destination.parent.mkdir(parents=True, exist_ok=True)
            destination.write_bytes(data)
            return module, {"path": "upstream/" + path, "git_blob": actual,
                            "bytes": len(data), "url": raw + "/" + path,
                            "imports": dependencies}

        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
            for module, item in pool.map(save, jobs):
                sources[module] = item
                for dependency in item["imports"]:
                    if dependency.split(".")[0] in prefixes:
                        if dependency not in sources:
                            pending.add(dependency)
                    else:
                        external.add(dependency)
        print(f"retained {len(sources)} modules; next wave {len(pending - sources.keys())}",
              file=sys.stderr, flush=True)

    order, visiting, visited = [], set(), set()

    def visit(module):
        if module in visiting:
            raise ValueError(f"import cycle at {module}")
        if module in visited:
            return
        visiting.add(module)
        for dependency in sources[module]["imports"]:
            if dependency in sources:
                visit(dependency)
        visiting.remove(module)
        visited.add(module)
        order.append(module)

    for module in args.entry:
        visit(module)
    manifest = {"repository": args.repo, "commit": args.commit,
                "source_root": args.source_root, "entry_modules": args.entry,
                "external_imports": sorted(external), "metadata": metadata,
                "dependency_order": order, "modules": dict(sorted(sources.items())),
                "evidence_kind": "source snapshot; not a compilation or axiom audit"}
    (output / "source-manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
    print(f"{len(sources)} modules, {sum(x['bytes'] for x in sources.values())} bytes; "
          f"external imports: {', '.join(sorted(external))}")


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"math-source-closure: {error}", file=sys.stderr)
        sys.exit(1)
