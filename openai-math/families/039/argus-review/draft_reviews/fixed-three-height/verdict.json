        "hypotheses": ["0<H", "0<d", "0<w", "6<=d^2*H", "d*w<1/3"],
        "conclusion": "There exist integers i,p,q and reals a,b,t with iq-3p=1, a0<a<W, b=W-a>0, t=a/b>T, a=Wt/(1+t), b=W/(1+t), -3a<3b<i/d, and i/d+3a=R.",
