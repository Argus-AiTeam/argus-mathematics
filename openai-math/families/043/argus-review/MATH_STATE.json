    },
    {
      "claim_id": "A_KNOWN_PRIME_REDUCTION",
      "version": 1,
      "context": {
        "kind": "context",
        "subject_id": "CTX_REVIEW_043",
        "content_hash": "7404db70fbd80c808ee5d550239a4f0f5271a645e14baf87f1b43737ea5c0d71"
      },
      "natural_statement": "For prime rank, the known variant P=W theorem together with the invariant reduction from GL_n P=W gives full SL_p P=W; these results alone do not discharge composite-rank variant cohomology.",
      "formal_statement": "",
      "external_assumptions": [
        {
          "assumption_id": "DCMS_PRIME",
          "statement": "For prime n and g>=2, P=W holds on variant cohomology; invariant P=W follows from GL_n P=W, hence the two full conjectures are equivalent.",
          "source": "de Cataldo, Maulik and Shen, On the P=W conjecture for SL_n, arXiv:2002.03336v1.",
          "source_id": "arxiv:2002.03336v1",
          "locator": "Theorem 0.2 and Proposition 1.2",
          "filed_by": "engineer:copilot",
          "content_hash": "1b109b49e4ee8cc6aba0a38eb92435410ea28e51de6cb918e826416160d5353e"
