    },
    {
      "claim_id": "C_KOSZUL_CONTRACTION",
      "version": 1,
      "context": {
        "kind": "context",
        "subject_id": "CTX_REVIEW_043",
        "content_hash": "7404db70fbd80c808ee5d550239a4f0f5271a645e14baf87f1b43737ea5c0d71"
      },
      "natural_statement": "For a central unit a and any commuting endomorphism d, D=[[d,0],[a,-d]] and h=[[0,a^-1],[0,0]] satisfy Dh+hD=I; if d^2=0 this contracts the complex. Applied over a characteristic-zero splitting field, a nonzero torus-monodromy Koszul coefficient yields acyclicity in every dimension and for every cover exponent.",
      "formal_statement": "",
      "external_assumptions": [],
      "retired_assumptions": [],
      "content_hash": "9e000958ee58ecd1e2e395837dbf4908efdcc49a991f69d45309c65c7bd799f5"
    },
    {
      "claim_id": "A_KNOWN_GL_PW",
      "version": 1,
      "context": {
        "kind": "context",
        "subject_id": "CTX_REVIEW_043",
        "content_hash": "7404db70fbd80c808ee5d550239a4f0f5271a645e14baf87f1b43737ea5c0d71"
      },
      "natural_statement": "In the smooth coprime GL_n setting for genus g>=2, P=W holds for all ranks. This is a known result of Maulik--Shen, not an Argus contribution.",
      "formal_statement": "",
      "external_assumptions": [
        {
          "assumption_id": "MS_GL_PW",
          "statement": "P=W for GL_n for every rank n and genus g>=2 in the smooth coprime setting.",
          "source": "Maulik and Shen, Annals of Mathematics 200 (2024), 529-556, primary journal abstract.",
          "source_id": "doi:10.4007/annals.2024.200.2.3",
          "locator": "Abstract",
          "filed_by": "engineer:copilot",
          "content_hash": "cfbc0c6dafa48d7d538f18d270f6e1a92912f772dd27dde6bf05d8fd1ae16e3c"
        }
      ],
      "retired_assumptions": [],
