  "source_equations": {
    "planted.tex:eq:planted-gain": "\\begin{equation}\\label{eq:planted-gain}g=\\max_{\\text{tuple}\\in\\mathcalU}\\left\\{g_C+\\sum_ib(s_i)-\\deltaP-\\sum_ip_i^2-vw-\\sum_ib(t_i)+b(v)\\right\\},\\end{equation}",
    "planted.tex:eq:planted-feasibility": "\\begin{equation}\\label{eq:planted-feasibility}\\begin{gathered}0\\leu\\le\\min(c,r),\\quad0\\ler'=r-u\\led,\\quad|\\delta|\\lec,\\quadd-\\delta=2r',\\\\P+T=\\sum_is_i\\led,\\qquad0\\let_i\\lep_i+\\delta,\\qquad0\\lev\\lep_i+\\delta\\quad(1\\lei\\le3),\\qquadw\\ge0.\\end{gathered}\\end{equation}",
    "planted.tex:eq:planted-two-active-gain": "\\begin{equation}\\label{eq:planted-two-active-gain}g_2(h)=\\max_{\\substack{p+t=h\\,;\\0\\let\\lep\\ler}}\\{b(h)-p^2-b(t)\\}=b(\\lfloorh/2\\rfloor).\\end{equation}",
    "tail.tex:eq:global-cost": "\\begin{equation}\\label{eq:global-cost}\\mathcalC=\\frac12\\left(\\sum_{j\\inJ}C_j-\\sum_{e\\inE}(1-a_e)b(h_e)\\right).\\end{equation}",
    "tail.tex:eq:tail-excess": "\\begin{equation}\\label{eq:tail-excess}\\mathcalE=\\frac12\\sum_{e\\inE}(a_e-1/3)b(h_e).\\end{equation}",
    "tail.tex:eq:tail-total-slack": "\\begin{equation}\\label{eq:tail-total-slack}\\mathcalC-\\sum_jg_j=\\sum_jS_j+\\mathcalE.\\end{equation}",
    "tail.tex:eq:tail-feasible": "\\begin{equation}\\label{eq:tail-feasible}\\begin{gathered}c\\ge|\\delta|,\\qquadP+T\\led,\\qquadp_\\ell,t_\\ell,v\\ge0,\\qquadt_\\ell,v\\lep_\\ell+\\delta,\\qquadw\\ge0.\\end{gathered}\\end{equation}",
    "tail.tex:eq:slack": "\\begin{equation}\\label{eq:slack}\\begin{split}S={}&\\frac{c(d+\\delta-1)-\\delta(d+2)+2\\delta^2}{4}\\\\&+\\sum_{\\ell=1}^3\\left[\\frac{(2p_\\ell-t_\\ell)(2p_\\ell-t_\\ell-1)}6+\\deltap_\\ell-\\fracc6(p_\\ell+t_\\ell)\\right]+vw-b(v).\\end{split}\\end{equation}",
    "tail.tex:eq:tail-quadratic": "\\begin{equation}\\label{eq:tail-quadratic}\\begin{split}Q={}&\\frac{c(d+\\delta)-\\deltad+2\\delta^2}{4}\\\\&+\\sum_{\\ell=1}^3\\left[\\frac{(2p_\\ell-t_\\ell)^2}{6}+\\deltap_\\ell-\\fracc6(p_\\ell+t_\\ell)\\right]+v\\left(\\frac{d-3\\delta}{2}-P\\right)+\\frac{v^2}{2}.\\end{split}\\end{equation}",
    "tail.tex:eq:tail-linear-loss": "\\begin{equation}\\label{eq:tail-linear-loss}S=Q-\\fracc4-\\frac\\delta2-\\frac{2P-T}{6}-\\fracv2.\\end{equation}",
    "tail.tex:eq:coercivity": "\\begin{equation}\\label{eq:coercivity}Q\\ge\\frac1{342}(P^2+T^2+\\delta^2).\\end{equation}",
    "tail.tex:eq:tail-budget": "\\begin{equation}\\label{eq:tail-budget}\\begin{split}&\\sum_{j\\inJ_3}\\frac{P_j^2+T_j^2+\\delta_j^2}{342}+\\sum_{j\\notinJ_3}\\frac{h_j^2}{24}+\\mathcalE\\le33M.\\end{split}\\end{equation}",
    "tail.tex:eq:tail-leading-coefficient": "\\begin{equation}\\label{eq:tail-leading-coefficient}S=Ad+R,\\qquadA=\\frac{c-\\delta+2v}{4}=\\frac{c-u+v}{2},\\end{equation}",
    "tail.tex:eq:tail-integer-slack": "\\begin{equation}\\label{eq:tail-integer-slack}S=\\frac{3c^2-3c}{4}+\\frac16\\sum_{\\ell=1}^3\\left[n_\\ell^2+(c-1)n_\\ell+3cp_\\ell\\right].\\end{equation}"
  },
