  "scope_findings": {
    "known_local_algorithm": "Singular 4.4 manual A.4.1 identifies the local Jacobian quotient with the power-series quotient, and explicitly requires a local monomial ordering. This audit instead certifies finite jets by exact rational row reduction and Nakayama stabilization.",
    "rejected_shortcut": "A global Groebner quotient of a polynomial replacement for a prepared analytic germ would neither localize at the origin nor justify removing its Weierstrass unit.",
    "literature_search": "No source for this particular yz=R, h+w(y^a+z^b) length formula was found in the focused search. Novelty is not established.",
    "milnor_original_source": "A public academic PDF URL returned 404 and another host required a browser challenge. No unread locator is cited. The proved quantity is the local Jacobian-algebra dimension, the Milnor-number convention used in the manuscript."
  },
  "mathematical_result": {
    "status": "engineer_proof_complete_pending_independent_review",
    "statement": "For each actual prepared germ and every fixed nonzero s, a,b>1 and ab>5(a+b) imply isolatedness and mu(f_i,s)=24ab+6a+6b+51.",
    "proof_artifact": "research/audit_report.tex",
    "formal_kernel_verification": false,
    "machine_evidence_scope": "Exact finite local-algebra inputs and symbolic identities, not a formal proof of the analytic length argument."
  },
