  "primary_sources": [
    {
      "source_id": "stacks:00DV",
      "url": "https://stacks.math.columbia.edu/tag/00DV",
      "locator": "Lemma 10.20.1(2)",
      "excerpt": "Let R be a ring with Jacobson radical rad(R). Let M be an R-module. Let I be a subset ideal of R. If IM=M, M is finite, and I is contained in rad(R), then M=0.",
      "application": "Consecutive equal jet lengths give m^D M=m(m^D M); the finite module m^D M vanishes.",
      "independent_attribution": "pending"
    },
    {
      "source_id": "stacks:00NQ",
      "url": "https://stacks.math.columbia.edu/tag/00NQ",
      "locator": "Lemma 10.106.3",
      "excerpt": "Let R be a regular local ring and let x_1,...,x_d be a minimal set of generators for the maximal ideal m. Then x_1,...,x_d is a regular sequence, and each R/(x_1,...,x_c) is a regular local ring of dimension d-c. In particular R is Cohen-Macaulay.",
      "application": "The convergent power-series ambient rings are regular local rings.",
      "independent_attribution": "pending"
    },
    {
      "source_id": "stacks:02JN",
      "url": "https://stacks.math.columbia.edu/tag/02JN",
      "locator": "Lemma 10.104.2",
      "excerpt": "Let R be a Noetherian local Cohen-Macaulay ring with maximal ideal m. Let x_1,...,x_c in m be elements. Then x_1,...,x_c is a regular sequence if and only if dim(R/(x_1,...,x_c))=dim(R)-c. If so, each quotient R/(x_1,...,x_i) is Cohen-Macaulay of dimension dim(R)-i.",
      "application": "The finite local intersections and the one-dimensional polar family have the required codimension.",
      "independent_attribution": "pending"
    },
    {
      "source_id": "stacks:00R4",
      "url": "https://stacks.math.columbia.edu/tag/00R4",
      "locator": "Lemma 10.128.1",
      "excerpt": "Let R to S be a local homomorphism of Noetherian local rings. Assume R is regular, S Cohen-Macaulay, and dim(S)=dim(R)+dim(S/m_R S). Then R to S is flat.",
      "application": "In the polar family, the parameter base has dimension one, the complete-intersection total has dimension one, and every local fiber has dimension zero.",
      "independent_attribution": "pending"
    },
    {
      "source_id": "isbn:9798866906680",
      "version": "4.4, May 31 2026",
      "url": "https://www.jirka.org/scv/scv.pdf",
      "locator": "Theorems 6.2.3 and 6.2.5",
      "excerpt": "Theorem 6.2.3: Suppose f is holomorphic on an open neighborhood U of 0 in C^(n-1) times C, f(0)=0, and z_n maps to f(0,z_n) is not identically zero near 0 and has order k>=1. On a smaller polydisc there are a unique nowhere-zero holomorphic unit u and unique degree-k Weierstrass polynomial P with f=uP. Theorem 6.2.5: If f is holomorphic near 0 and P is a degree-k Weierstrass polynomial, there are unique holomorphic q,r on a neighborhood with f=qP+r, where r is polynomial of degree less than k in z_n.",
      "application": "The graph specializations have exact w-order four and leading coefficient one. Successive monic quotients in the proof have the asserted free ranks.",
      "independent_attribution": "pending"
    },
    {
      "source_id": "isbn:9798866906680",
      "version": "4.4, May 31 2026",
      "url": "https://www.jirka.org/scv/scv.pdf",
      "locator": "Theorems 6.7.4 and 6.7.6, pp. 194-195",
      "excerpt": "Theorem 6.7.4: An irreducible analytic germ of dimension k admits, after a linear coordinate change, a proper local projection to C^k which is a finite-sheeted covering off a proper discriminant subvariety; the covering locus is dense. Theorem 6.7.6: For holomorphic f on a neighborhood in C times C^(n-1), suppose f=0 defines a one-dimensional subvariety containing 0 and w maps to f(0,w) has an isolated zero. There are an integer k>0 and holomorphic g near 0 with f(xi^k,g(xi))=0.",
      "application": "An off-axis analytic component supplies, after a generic slice and parametrization, the arc contradicted by the explicit valuation inequalities.",
      "independent_attribution": "pending"
    },
    {
      "source_id": "url:https://www.singular.uni-kl.de/Manual/4-4/sing_960.htm",
      "url": "https://www.singular.uni-kl.de/Manual/4-4/sing_960.htm",
      "locator": "A.4.1 Milnor and Tjurina number",
      "excerpt": "Singular cannot compute with infinite power series. But it can work in the localization of K[x_1,...,x_n] at (x_1,...,x_n). To do this, one has to define a ring with a local monomial ordering such as ds, Ds, ls, ws, Ws. For theoretical reasons, the vector space dimension computed over the localization ring coincides with the Milnor (resp. Tjurina) number as defined above (in the power series ring).",
      "application": "Global and local critical-point counts must not be conflated. The standalone proof inputs instead use exact finite-jet linear algebra plus a proved Nakayama stopping criterion.",
      "independent_attribution": "pending"
    }
  ],
